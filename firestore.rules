rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'cosmetic', 'timeOfDay', 'hasDailyMedal', 'createdAt']) &&
             data.keys().hasOnly(['playerName', 'score', 'cosmetic', 'timeOfDay', 'hasDailyMedal', 'createdAt']) &&
             data.playerName is string &&
             data.playerName.size() >= 1 &&
             data.playerName.size() <= 18 &&
             data.score is int &&
             data.score >= 0 &&
             data.score <= 99999 &&
             data.cosmetic in ['none', 'crown', 'goggles', 'crest', 'halo'] &&
             data.timeOfDay in ['Sunrise', 'Midday', 'Sunset', 'Night'] &&
             data.hasDailyMedal is bool &&
             data.createdAt == request.time;
    }

    // Public Global Leaderboard
    match /leaderboard/{entryId} {
      // Anyone can view global high scores
      allow read: if true;

      // Players can submit high scores validated by schema and server timestamp
      allow create: if isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);

      // Leaderboard entries are immutable once submitted
      allow update, delete: if false;
    }
  }
}
